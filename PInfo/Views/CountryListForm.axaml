<Views:AppForm xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:Views="using:PInfo.Views"
               xmlns:Models="using:PInfo"
               x:Class="PInfo.Views.CountryListForm"
               Background="{StaticResource SurfaceColor}">
    <Grid RowDefinitions="Auto,Auto,*" Margin="16">
        <StackPanel Spacing="6" Margin="4,4,4,16">
            <TextBlock Text="Countries" FontSize="28" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryColor}"/>
            <TextBlock Text="Explore countries around the world" Classes="Body"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="10" Margin="0,0,0,12">
            <TextBox x:Name="edtSearch" PlaceholderText="Search by country name or ISO code"
                     FontSize="16" Padding="12" CornerRadius="10"/>
            <TextBlock x:Name="ResultCountText" Classes="Body" Margin="4,0"/>
            <ProgressBar x:Name="LoadingProgress" IsIndeterminate="True" IsVisible="False" Height="4"/>
            <Border x:Name="NoticePanel" IsVisible="False" Background="#FFF1E8"
                    CornerRadius="10" Padding="12">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="NoticeText" Foreground="#7C3A12" TextWrapping="Wrap"/>
                    <Button x:Name="btnRetry" Content="Try again" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>
        <Grid Grid.Row="2">
            <ListBox x:Name="CountryList" Background="Transparent" BorderThickness="0"
                     SelectionMode="Single">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="Models:CountryModel">
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="12" Padding="14,12">
                            <Grid ColumnDefinitions="56,*,Auto">
                                <TextBlock Text="{Binding Flag}" FontSize="32" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="18"
                                           FontWeight="SemiBold" Foreground="{StaticResource PrimaryColor}"
                                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Border Grid.Column="2" Background="#EDF2F7" CornerRadius="6"
                                        Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Alpha3Code}" FontSize="12"
                                               FontWeight="SemiBold" Foreground="#4A5568"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyText" Text="No countries match your search."
                       IsVisible="False" Classes="Body" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"/>
        </Grid>
    </Grid>
</Views:AppForm>
