<Views:AppForm xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:Views="using:PInfo.Views"
               xmlns:Models="using:PInfo"
               x:Class="PInfo.Views.CountryListForm"
               Classes="FormBackground">
    <Grid RowDefinitions="Auto,Auto,*" Margin="16">
        <StackPanel Classes="FormHeader">
            <TextBlock Text="Countries" Classes="FormTitle"/>
            <TextBlock Text="Explore countries around the world" Classes="BodyText"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="10" Margin="0,0,0,12">
            <TextBox x:Name="edtSearch" PlaceholderText="Search by country name or ISO code"
                     Classes="SearchBox"/>
            <TextBlock x:Name="ResultCountText" Classes="BodyText" Margin="4,0"/>
            <ProgressBar x:Name="LoadingProgress" Classes="LoadingBar" IsVisible="False"/>
            <Border x:Name="NoticePanel" IsVisible="False" Classes="NoticePanel">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="NoticeText" Classes="NoticeText"/>
                    <Button x:Name="btnRetry" Content="Try again" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>
        <Grid Grid.Row="2">
            <ListBox x:Name="CountryList" Classes="ItemList"
                     SelectionMode="Single">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="Models:CountryModel">
                        <Border Classes="ListItem">
                            <Grid ColumnDefinitions="56,*,Auto">
                                <TextBlock Text="{Binding Flag}" Classes="FlagEmoji"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="ListItemTitle" Margin="0,0,12,0"/>
                                <Border Grid.Column="2" Classes="Badge">
                                    <TextBlock Text="{Binding Alpha3Code}" Classes="BadgeText"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyText" Text="No countries match your search."
                       IsVisible="False" Classes="EmptyStateText"/>
        </Grid>
    </Grid>
</Views:AppForm>
