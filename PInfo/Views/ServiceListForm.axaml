<Views:AppForm
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Views="using:PInfo.Views"
    xmlns:Models="using:PInfo"
    x:Class="PInfo.Views.ServiceListForm"
    Classes="FormBackground">
    <Grid RowDefinitions="Auto,*" Margin="16">
        <!-- Header of the secondary view -->
        <StackPanel Classes="FormHeader">
            <TextBlock Text="Services" Classes="FormTitle"/>
            <TextBlock Text="Choose a service to explore" Classes="BodyText"/>
        </StackPanel>
        <!-- Available services from the application host -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ServiceList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="Models:PublicServiceItem">
                        <Button Click="AnyClick" Classes="ListItem">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Service.Name}" Classes="ListItemTitle"/>
                                <TextBlock Grid.Column="1" Text="Open" Classes="ListItemText" Margin="16,0,0,0"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Views:AppForm>
