<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="PInfo.Views.MainView">
    
    <ContentControl x:Name="RootContainer" Classes="ViewHost">
    <!-- Grid layout with 3 rows: Header, Content Container, and Status Bar -->
    <Grid x:Name="MainLayout" RowDefinitions="Auto, *, Auto">

        <!-- 1. Header / Toolbar -->
        <Border Grid.Row="0" Classes="Toolbar MainToolbar">
            <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="PInfo" Classes="ToolbarTitle"/>
                <!-- No events here, buttons have x:Name for code-behind binding -->
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="btnSettings" Content="⚙️" Classes="PrimaryButton ToolbarIcon MainToolbarButton"
                        ToolTip.Tip="Settings" AutomationProperties.Name="Settings"/>
                <Button x:Name="btnAbout" Content="ℹ️" Classes="PrimaryButton ToolbarIcon MainToolbarButton"
                        ToolTip.Tip="About" AutomationProperties.Name="About"/>
            </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Content Container for dynamic view switching -->
        <ContentControl x:Name="ViewContainer" Grid.Row="1" Classes="FormBackground ViewHost"/>

        <!-- 3. Status Bar / Footer -->
        <Border Grid.Row="2" Classes="Statusbar">
            <TextBlock Text="Status: Ready" Classes="StatusbarText"/>
        </Border>

    </Grid>
    </ContentControl>
 
</UserControl>
