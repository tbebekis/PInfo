<Views:AppForm xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:Views="using:PInfo.Views"
               x:Class="PInfo.Views.AppCardForm"
               Classes="FormBackground">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16" Spacing="16">
            <Border Classes="CardHeader">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="HeaderIconText" Classes="FlagEmoji CardIcon"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="TitleText" Classes="CardTitle"/>
                    </Grid>
                    <TextBlock x:Name="SubtitleText" Classes="CardSubtitle"/>
                    <WrapPanel x:Name="BadgePanel"/>
                    <WrapPanel x:Name="HeaderActionsPanel" IsVisible="False"/>
                </StackPanel>
            </Border>
            <StackPanel x:Name="SectionPanel" Spacing="16"/>
            <TextBlock x:Name="SourceText" IsVisible="False" Classes="SecondaryText" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Views:AppForm>
