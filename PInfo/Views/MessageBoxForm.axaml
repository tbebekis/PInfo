<Views:AppForm
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Views="using:PInfo.Views"
    x:Class="PInfo.Views.MessageBoxForm"
    Classes="FormBackground">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Classes="Toolbar">
            <TextBlock x:Name="ModeText" Classes="ToolbarTitle"/>
        </Border>
        <ScrollViewer Grid.Row="1" Margin="24" HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="MessageText" Classes="MessageText"/>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Classes="MessageButtons">
            <Button x:Name="btnNo" Content="No" Classes="MessageButton"/>
            <Button x:Name="btnYes" Content="Yes" Classes="MessageButton"/>
            <Button x:Name="btnOK" Content="OK" Classes="MessageButton"/>
        </StackPanel>
    </Grid>
</Views:AppForm>
